{
  "manifest_version": 2,
  "name": "harvester",
  "version": "2.2.0",
  "description": "Send explicitly selected media to the local harvester companion.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "https://www.instagram.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "harvester",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/harvester-16.png",
      "32": "icons/harvester-32.png",
      "48": "icons/harvester-48.png",
      "64": "icons/harvester-64.png",
      "96": "icons/harvester-96.png",
      "128": "icons/harvester-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@harvester-sxrvys",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/harvester-48.png",
    "96": "icons/harvester-96.png",
    "128": "icons/harvester-128.png"
  }
}
